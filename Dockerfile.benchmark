FROM python:3.12-slim

WORKDIR /work
RUN apt-get update && apt-get install -y --no-install-recommends cmake g++ make libsqlite3-dev sqlite3 && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml ./
COPY CMakeLists.txt ./
COPY chronovec ./chronovec
COPY benchmarks ./benchmarks
COPY native ./native

RUN pip install --no-cache-dir numpy hnswlib scann psutil
RUN cmake -S . -B build -DCMAKE_BUILD_TYPE=Release -DCHRONOVEC_BUILD_SQLITE=ON && cmake --build build -j 2

ENTRYPOINT ["python", "benchmarks/run_benchmark.py"]
